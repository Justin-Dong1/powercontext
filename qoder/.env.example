# 复制为 .env 后按需修改；所有值均为本地默认值，不含任何真实凭据。

# 应用监听地址与端口
RT_HOST=127.0.0.1
RT_PORT=8000

# 应用运行数据目录（SQLite 资料库会写入这里）
RT_DATA_DIR=./data/app

# 可选：单独指定 SQLite 文件位置；留空则使用 RT_DATA_DIR/researchtrail.sqlite3
# RT_DATABASE_PATH=./data/app/researchtrail.sqlite3

# PowerContext Server 地址（由 scripts/run.py 自动启动时无需修改）
RT_POWERCONTEXT_URL=http://127.0.0.1:8765

# PowerContext 数据目录（Scope / Memory 持久化位置）
POWERCONTEXT_HOME=./data/powercontext

# 可选：若复用已运行的 PowerContext Server，将下面设为 1 跳过自动启动
# RT_REUSE_POWERCONTEXT=0

# 可选：PowerContext 自身的嵌入/模型提供方配置。本项目验收流程不依赖外部模型，
# 如启用语义搜索等能力，请参考 PowerContext 官方文档按需填写，切勿提交真实密钥。
# POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
# POWERCONTEXT_SERVER_HTTP_PORT=8765
